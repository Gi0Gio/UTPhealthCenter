<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Students.PatientRegisterPage"
             BackgroundImageSource="fondete.jpeg"
            BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff}"
            NavigationPage.HasBackButton="False"
            NavigationPage.HasNavigationBar="False">
    <AbsoluteLayout>
        <Image Source="backgroundlogin.png"
               Aspect="AspectFill"
               AbsoluteLayout.LayoutBounds="0,0,1,1"
               AbsoluteLayout.LayoutFlags="All"/>
        <Frame BackgroundColor="#fff"
               CornerRadius="15"
               HasShadow="True"
               WidthRequest="500"
               AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
               AbsoluteLayout.LayoutFlags="PositionProportional">
            <VerticalStackLayout Padding="20" Spacing="10">
                <Image Source="logo2.png"
                       WidthRequest="100"
                       HeightRequest="100"
                       HorizontalOptions="Center"/>

                <Entry x:Name="FirstNameEntry"
                       Placeholder="Nombre de usuario"
                       BackgroundColor="#F5F5F5"
                       FontFamily="MohaveRegular"
                       FontSize="20"
                       TextColor="#000"
                       Margin="0,5"/>

                <Entry x:Name="LastNameEntry"
                       Placeholder="Apellido"
                       BackgroundColor="#F5F5F5"
                       FontFamily="MohaveRegular"
                       FontSize="20"
                       TextColor="#000"
                       Margin="0,5"/>

                <Entry x:Name="DniEntry"
                       Placeholder="Cédula (DNI)"
                       BackgroundColor="#F5F5F5"
                       FontFamily="MohaveRegular"
                       FontSize="20"
                       TextColor="#000"
                       Margin="0,5"/>

                <Entry x:Name="AddressEntry"
                       Placeholder="Dirección"
                       BackgroundColor="#F5F5F5"
                       FontFamily="MohaveRegular"
                       FontSize="20"
                       TextColor="#000"
                       Margin="0,5"/>

                <Entry x:Name="PhoneNumberEntry"
                       Placeholder="Número de Teléfono"
                       BackgroundColor="#F5F5F5"
                       FontFamily="MohaveRegular"
                       FontSize="20"
                       TextColor="#000"
                       Margin="0,5"/>

                <Label Text="Fecha de Nacimiento"
                       TextColor="#000"
                       FontSize="20"
                       FontFamily="MohaveRegular"
                       Margin="0,5"/>
                <DatePicker x:Name="BirthDatePicker"
                            BackgroundColor="#F5F5F5"
                            FontFamily="MohaveRegular"
                            FontSize="20"
                            TextColor="#000"
                            Margin="0,5"
                            Format="dd/MM/yyyy"/>

                <StackLayout>
                    <Button Text="Completar Registro" 
                            FontFamily="MohaveRegular"     
                            FontSize="20"
                            BackgroundColor="#4FB9FB" 
                            TextColor="White"
                            CornerRadius="10"
                            Margin="5"
                            Clicked="OnRegisterClicked"/>
                </StackLayout>
            </VerticalStackLayout>
        </Frame>
    </AbsoluteLayout>
</ContentPage>
