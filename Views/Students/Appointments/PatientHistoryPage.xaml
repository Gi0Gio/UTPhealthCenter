<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Students.Appointments.PatientHistoryPage"
             xmlns:components="clr-namespace:HealthCare.Components"
             BackgroundColor="#fff">
    <!-- Main Layout -->
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#ffffff">

        <!-- Static Navbar/SideMenu at the Top -->
        <StackLayout Grid.Row="0">
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />
            <Label Text="Historial de Citas"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#000000"
               Margin="0,10,0,0" />
        </StackLayout>

        <!-- Scrollable Content with Appointment Cards -->
        <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
            <FlexLayout Padding="20,0"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Center"
                        JustifyContent="SpaceEvenly">

                <!-- Appointment Card 1 -->
                <Frame WidthRequest="600" HeightRequest="220" BackgroundColor="#d9d9d9" CornerRadius="8" Padding="10" HasShadow="True"
                       Margin="2">
                    <VerticalStackLayout>
                        <Label Text="Doctor" FontFamily="Mohave-Regular" FontAttributes="Bold" TextColor="#000000"/>
                        <Label Text="Chavarría" FontFamily="Mohave-Regular" TextColor="#000000" />
                        <Label Text="Estado de la cita" FontFamily="Mohave-Regular" FontAttributes="Bold" TextColor="#000000" />
                        <Label Text="Pendiente" FontFamily="MohaveRegular" TextColor="#000000" />
                        <Label Text="Descripción de la cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                        <Label Text="Chequeo de seguimiento después de tratamiento" FontFamily="MohaveRegular" TextColor="#000000" />
                        <Label Text="Día de la cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                        <Label Text="20/15/2024 14:12" FontFamily="MohaveRegular" TextColor="#000000" />
                        <Label Text="Tipo de cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                        <Label Text="Seguimiento" FontFamily="MohaveRegular" TextColor="#000000" />
                    </VerticalStackLayout>
                </Frame>

