<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Students.Appointments.PatientHistoryPage"
             xmlns:components="clr-namespace:HealthCare.Components"
             BackgroundColor="#fff">

    <VerticalStackLayout>

        <!-- Navbar para escritorio y SideMenu para móvil -->
        <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
        <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="30" Padding="40">
            <!-- Main Layout with Grid for Two Columns -->
            <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*" BackgroundColor="#ffffff">

        <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
            <Label Text="Historial de Citas"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#000000"
                   Margin="0,10,0,0" />
        </StackLayout>

        <!-- Accepted Appointments Column (Left) -->
        <StackLayout Grid.Row="1" Grid.Column="0" Padding="10">
            <Label Text="Citas Aceptadas"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#000" />

            <CollectionView x:Name="AcceptedAppointmentsList" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#d9d9d9" CornerRadius="8" Padding="10" HasShadow="True" Margin="5">
                            <VerticalStackLayout>
                                <Label Text="Doctor" FontAttributes="Bold" TextColor="#000000"/>
                                <Label Text="{Binding DoctorName}" TextColor="#000000" />
                                <Label Text="Descripción" FontAttributes="Bold" TextColor="#000000" />
                                <Label Text="{Binding Description}" TextColor="#000000" />
                                <Label Text="Fecha de la cita" FontAttributes="Bold" TextColor="#000000" />
                                <Label Text="{Binding AppointmentDate}" TextColor="#000000" />
                                <Label Text="Tipo de cita" FontAttributes="Bold" TextColor="#000000" />
                                <Label Text="{Binding Type}" TextColor="#000000" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>

        <!-- Pending Appointments Column (Right) -->
        <StackLayout Grid.Row="1" Grid.Column="1" Padding="10">
            <Label Text="Citas Pendientes"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#000" />

            <CollectionView x:Name="PendingAppointmentsList" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#d9d9d9" CornerRadius="8" Padding="10" HasShadow="True" Margin="5">
                            <VerticalStackLayout>
                                <Label Text="Doctor" FontAttributes="Bold" TextColor="#000000"/>
                                <Label Text="{Binding DoctorName}" TextColor="#000000" />
                                <Label Text="Descripción" FontAttributes="Bold" TextColor="#000000" />
                                <Label Text="{Binding Description}" TextColor="#000000" />
                                <Label Text="Fecha de la cita" FontAttributes="Bold" TextColor="#000000" />
                                <Label Text="{Binding AppointmentDate}" TextColor="#000000" />
                                <Label Text="Tipo de cita" FontAttributes="Bold" TextColor="#000000" />
                                <Label Text="{Binding Type}" TextColor="#000000" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>

    </Grid>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
