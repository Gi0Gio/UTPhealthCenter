<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Students.Appointments.PatientRequestPage"
             xmlns:components="clr-namespace:HealthCare.Components"
             BackgroundImageSource="fondete.jpeg"
            BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff}"
            NavigationPage.HasBackButton="False"
            NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="20,10,20,10">

            <!-- Navbar para escritorio y SideMenu para móvil -->
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

            <!-- Título principal -->
            <Label Text="Gestión de Citas"
               FontFamily="MohaveRegular"
               FontAttributes="Bold, Italic"
               FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}"
               TextColor="#000"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

            <!-- Formulario -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" 
              ColumnSpacing="25" RowSpacing="20"
              HorizontalOptions="FillAndExpand"
              Padding="10,0">

                <!-- Tipo de cita -->
                <Label Text="Tipo de cita"
                   FontFamily="MohaveRegular"
                   FontSize="{OnIdiom Phone=20, Desktop=26, Tablet=26}"
                   FontAttributes="Bold"
                   TextColor="#000"
                   VerticalTextAlignment="Center"
                   Grid.Row="0" Grid.Column="0" />
                <Picker x:Name="TypeEntry"
                    Title="Seleccione tipo de cita"
                    FontFamily="MohaveRegular"
                    FontSize="{OnIdiom Phone=20, Desktop=22, Tablet=22}"
                    BackgroundColor="#E3F2FD"
                    TextColor="#000"
                    Grid.Row="0" Grid.Column="1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Consulta General</x:String>
                            <x:String>Chequeo de Rutina</x:String>
                            <x:String>Especialista</x:String>
                            <x:String>Examen de Laboratorio</x:String>
                            <x:String>Revisión Médica</x:String>
                            <x:String>Consulta Pediátrica</x:String>
                            <x:String>Psicología</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <!-- Día de la cita -->
                <Label Text="Día de la cita"
                   FontFamily="MohaveRegular"
                   FontSize="{OnIdiom Phone=20, Desktop=26, Tablet=26}"
                   FontAttributes="Bold"
                   TextColor="#000"
                   VerticalTextAlignment="Center"
                   Grid.Row="1" Grid.Column="0" />
                <DatePicker x:Name="AppointmentDatePicker"
                        FontFamily="MohaveRegular"
                        FontSize="20"
                        BackgroundColor="#E3F2FD"
                        TextColor="#000"
                        Grid.Row="1" Grid.Column="1" />

                <!-- Descripción -->
                <Label Text="Descripción de la cita"
                   FontFamily="MohaveRegular"
                   FontSize="{OnIdiom Phone=20, Desktop=26, Tablet=26}"
                   FontAttributes="Bold"
                   TextColor="#000"
                   VerticalTextAlignment="Center"
                   Grid.Row="2" Grid.Column="0" />
                <Entry x:Name="DescriptionEditor"
                   Placeholder="Describa el motivo de su cita"
                   FontFamily="MohaveRegular"
                   FontSize="{OnIdiom Phone=20, Desktop=22, Tablet=22}"
                   BackgroundColor="#E3F2FD"
                   TextColor="#666"
                   Grid.Row="2" Grid.Column="1" />
            </Grid>

            <!-- Botón de solicitud -->
            <Button Text="Hacer Solicitud"
                FontSize="18"
                BackgroundColor="#006aab"
                TextColor="#fff"
                CornerRadius="10"
                HorizontalOptions="Center"
                WidthRequest="200"
                Margin="0,30,0,0"
                Clicked="OnRequestAppointmentClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
