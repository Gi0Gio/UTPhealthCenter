<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Students.Appointments.PatientRequestPage"
             xmlns:components="clr-namespace:HealthCare.Components"
             BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff, Tablet=#fff}"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout>

        <!-- Navbar para escritorio y SideMenu para móvil -->
        <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
        <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="30" Padding="40">
            <Label Text="Gestión de Citas" 
                   FontFamily="MohaveRegular"
                   FontAttributes="Bold,Italic"
                   TextColor="#000" 
                   HorizontalOptions="Center"
                   FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}" />

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" 
                  HorizontalOptions="Center" ColumnSpacing="25" RowSpacing="50">

                <Label Text="Tipo de cita" 
                       FontFamily="MohaveRegular"
                       FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}"
                       FontAttributes="Bold"
                       TextColor="#000" 
                       Grid.Row="0" 
                       Grid.Column="0" 
                       VerticalTextAlignment="Center" />

                <Picker Title="Seleccione tipo de cita" 
                        TitleColor="#000"
                        FontFamily="MohaveRegular"
                        FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}" 
                        BackgroundColor="#E3F2FD" 
                        TextColor="#666" 
                        Grid.Row="0" 
                        Grid.Column="1"
                        x:Name="TypeEntry">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Consulta General</x:String>
                            <x:String>Chequeo de Rutina</x:String>
                            <x:String>Especialista</x:String>
                            <x:String>Examen de Laboratorio</x:String>
                            <x:String>Revisión Médica</x:String>
                            <x:String>Consulta Pediátrica</x:String>
                            <x:String>Psicología</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Día de la cita" 
                       TextColor="#000"
                       FontFamily="MohaveRegular"
                       FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}" 
                       FontAttributes="Bold"
                       Grid.Row="1" 
                       Grid.Column="0" 
                       VerticalTextAlignment="Center" />

                <DatePicker x:Name="AppointmentDatePicker"
                            FontSize="18" 
                            BackgroundColor="#E3F2FD" 
                            TextColor="#666" 
                            FontFamily="MohaveRegular"
                            Grid.Row="1" 
                            Grid.Column="1" />

                <Label Text="Descripción de la cita" 
                       FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}"
                       FontAttributes="Bold"
                       TextColor="#000" 
                       Grid.Row="2" 
                       Grid.Column="0" 
                       VerticalTextAlignment="Center" />

                <Entry x:Name="DescriptionEditor" 
                       Placeholder="Describa el motivo de su cita" 
                       FontSize="{OnIdiom Phone=22, Desktop=30, Tablet=30}" 
                       FontFamily="MohaveRegular"
                       BackgroundColor="#f5f5f5" 
                       TextColor="#666" 
                       Grid.Row="2" 
                       Grid.Column="1" />
            </Grid>

            <!-- Updated button to call OnRequestAppointmentClicked -->
            <Button Text="Hacer Solicitud" 
                    FontSize="18" 
                    BackgroundColor="#006aab" 
                    TextColor="#fff" 
                    CornerRadius="10" 
                    HorizontalOptions="Center" 
                    WidthRequest="200" 
                    Margin="0,20,0,0"
                    Clicked="OnRequestAppointmentClicked"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
