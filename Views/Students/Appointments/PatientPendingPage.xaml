<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:HealthCare.Components"
             x:Class="HealthCare.Views.Students.Appointments.PatientPendingPage"
             BackgroundColor="#ffffff"
             NavigationPage.HasNavigationBar="False">

    <!-- Main Layout -->
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#ffffff">

        <!-- Static Navbar/SideMenu at the Top -->
        <StackLayout Grid.Row="0">
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />
            <Label Text="Citas pendientes"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#000000"
                   Margin="0,10,0,0" />
        </StackLayout>

        <!-- Scrollable Content with Appointment Cards -->
        <CollectionView Grid.Row="1" VerticalOptions="FillAndExpand" ItemsSource="{Binding PendingAppointments}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame WidthRequest="600" HeightRequest="200" BackgroundColor="#d9d9d9" CornerRadius="8" Padding="10" HasShadow="True" Margin="2">
                        <VerticalStackLayout>
                            <Label Text="Doctor" FontFamily="Mohave-Regular" FontAttributes="Bold" TextColor="#000000"/>
                            <Label Text="{Binding DoctorName}" FontFamily="Mohave-Regular" TextColor="#000000" />
                            <Label Text="Estado de la cita" FontFamily="Mohave-Regular" FontAttributes="Bold" TextColor="#000000" />
                            <Label Text="{Binding Status}" FontFamily="MohaveRegular" TextColor="#000000" />
                            <Label Text="Descripción de la cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                            <Label Text="{Binding Description}" FontFamily="MohaveRegular" TextColor="#000000" />
                            <Label Text="Día de la cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                            <Label Text="{Binding AppointmentDate}" FontFamily="MohaveRegular" TextColor="#000000" />
                            <Label Text="Tipo de cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                            <Label Text="{Binding Type}" FontFamily="MohaveRegular" TextColor="#000000" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Static Button at the Bottom -->
        <Button Text="Solicitar nueva cita"
                BackgroundColor="#014671"
                TextColor="#fff"
                FontSize="20"
                FontFamily="MohaveRegular"
                Margin="30"
                CornerRadius="10"
                Clicked="Request"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="End"
                Grid.Row="2"/>
    </Grid>
</ContentPage>
