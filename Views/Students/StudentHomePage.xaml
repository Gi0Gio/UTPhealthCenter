<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:HealthCare.Components"
             x:Class="HealthCare.Views.Students.StudentHomePage"
             BackgroundImageSource="fondete.jpeg"
             BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff, Tablet=#fff}"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

            <Label Text="Servicios HealthCare para Pacientes"
                   FontSize="35"
                   FontFamily="MohaveRegular"
                   FontAttributes="Italic, Bold"
                   TextColor="#000"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>
            
            <!-- Diseño para móviles -->
            <OnIdiom x:TypeArguments="View">
                <OnIdiom.Phone>

                    <ScrollView>
                        <VerticalStackLayout Padding="20" Spacing="15">
                            <Frame BackgroundColor="#def7ff"
                                   CornerRadius="15"
                                   HasShadow="True"
                                   Padding="10"
                                   Margin="0,5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Request"/>
                                </Frame.GestureRecognizers>
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="consulta.png"
                                           WidthRequest="50"
                                           HeightRequest="50"/>
                                    <Label Text="Solicitar citas"
                                           FontSize="30"
                                           FontFamily="Mohave-Regular"
                                           TextColor="Black"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="#def7ff"
                                   CornerRadius="15"
                                   HasShadow="True"
                                   Padding="10"
                                   Margin="0,5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="History"/>
                                </Frame.GestureRecognizers>
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="buenaconsulta.png"
                                           WidthRequest="50"
                                           HeightRequest="50"/>
                                    <Label Text="Historial"
                                           FontSize="30"
                                           FontFamily="Mohave-Regular"
                                           TextColor="#000"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                            
                            <Frame BackgroundColor="#def7ff" 
                                   CornerRadius="15"
                                   HasShadow="True"
                                   Padding="10"
                                   Margin="0,5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Prescription"/>
                                </Frame.GestureRecognizers>
                                <HorizontalStackLayout Spacing="15">
                                  <Image Source="receta2.png"
                                       WidthRequest="50"
                                       HeightRequest="50"/>
                                   <Label Text="Ver recetas"
                                        FontSize="30"
                                        FontFamily="Mohave-Regular"
                                        TextColor="#000" 
                                        VerticalOptions = "Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                            
                        </VerticalStackLayout>
                    </ScrollView>
                </OnIdiom.Phone>
                <OnIdiom.Desktop>
                    <Grid Padding="0" ColumnSpacing="15" RowSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#def7ff"
                               CornerRadius="15" HasShadow="True" Padding="0" Margin="20"
                               BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Request"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="consulta.png" WidthRequest="70" HeightRequest="70"/>
                                <Label Text="Solicitar Citas" FontSize="30" FontFamily="Mohave-Regular"
                                       TextColor="#000" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#def7ff"
                               CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="History"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="buenaconsulta.png" WidthRequest="70" HeightRequest="70"/>
                                <Label Text="Ver Historial" FontSize="30" FontFamily="Mohave-Regular"
                                       TextColor="#000" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="2" BackgroundColor="#def7ff"
                               CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Prescription"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="receta2.png" WidthRequest="70" HeightRequest="70"/>
                                <Label Text="Ver recetas" FontSize="30" FontFamily="Mohave-Regular"
                                       TextColor="#000" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </OnIdiom.Desktop>
                <OnIdiom.Tablet>
                    <Grid Padding="0" ColumnSpacing="15" RowSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <Frame Grid.Row="0"  Grid.Column="0" BackgroundColor="#def7ff" CornerRadius="15"  HasShadow="True"  Padding="0" 
                               Margin="20" BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Request"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="consulta.png" WidthRequest="70" HeightRequest="70"/>
                                <Label Text="Solicitar Citas" FontSize="30" FontFamily="Mohave-Regular" TextColor="#000"
                                       VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#def7ff" CornerRadius="15" HasShadow="True" 
                               Padding="0" Margin="20" BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="History"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="buenaconsulta.png" WidthRequest="70" HeightRequest="70"/>
                                <Label Text="Ver Historial" FontSize="30" FontFamily="Mohave-Regular" TextColor="#000" 
                                       VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="2" BackgroundColor="#def7ff"
                               CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Prescription"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="receta2.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Ver recetas" 
                                           FontSize="30" 
                                           FontFamily="Mohave-Regular"
                                           TextColor="#000" 
                                           VerticalOptions="Center" 
                                           HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1"  Grid.Column="1" BackgroundColor="#def7ff" CornerRadius="15"  HasShadow="True"  Padding="0" 
                            Margin="20" BorderColor="#00000040">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Perfil"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="consulta.png" WidthRequest="70" HeightRequest="70"/>
                                <Label Text="Perfil" FontSize="30" FontFamily="Mohave-Regular" TextColor="#000"
                                VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </OnIdiom.Tablet>
            </OnIdiom>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>