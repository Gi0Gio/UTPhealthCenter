<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Students.PatientProfilePage"
             xmlns:components="clr-namespace:HealthCare.Components"
             BackgroundColor="#ffffff"
             NavigationPage.HasNavigationBar="False">

    <!-- Main Layout -->
    <VerticalStackLayout>

        <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
        <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

        <Frame BackgroundColor="#d9d9d9" CornerRadius="8" Margin="100" HasShadow="True">
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceEvenly" AlignContent="Center"  HeightRequest="100">

                <Image Source="perfil.png" WidthRequest="50" HeightRequest="100" />

                <StackLayout>
                    <Label Text="Giovanny Jované" FontFamily="Mohave-Regular" FontSize="25" TextColor="#000000" FontAttributes="Bold"/>
                    <Label Text="8-1007-851" FontFamily="Mohave-Regular" FontSize="20" TextColor="#000000" />
                </StackLayout>

                <StackLayout>
                    <Label Text="Nacimiento/ Edad" FontFamily="Mohave-Regular" FontAttributes="Bold" FontSize="25" TextColor="#000000" />
                    <Label Text="02/03/2004, 20 años" FontFamily="Mohave-Regular" FontSize="20" TextColor="#000000" />
                </StackLayout>

                <StackLayout>
                    <Label Text="CHC4+H74 David, Panamá." FontFamily="Mohave-Regular" FontSize="25" TextColor="#000000" />
                    <Label Text="69971648" FontFamily="Mohave-Regular" FontSize="20" TextColor="#000000" />
                </StackLayout>

            </FlexLayout>
        </Frame>

        <!-- Footer Section -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="EndAndExpand" Padding="20" Margin="20">
            <FlexLayout Direction="Row" JustifyContent="SpaceAround" AlignItems="Center" Wrap="NoWrap">
                <Image Source="logouniver.png" WidthRequest="150" HeightRequest="150" />
                <Label Text="Dirección: David, Chiriquí    Correo Electrónico: clinicautp@utp.ac.pa"
                   FontFamily="Mohave-Regular" FontSize="20" TextColor="#000000" HorizontalTextAlignment="Center" />
                <Image Source="logo2.png" WidthRequest="150" HeightRequest="150" />
            </FlexLayout>
            <FlexLayout Direction="Row" JustifyContent="Center" AlignItems="Center" Wrap="NoWrap">
                <Label Text="Horario de Atención: 8:00 am a 4:00 pm     Teléfono: 777-4000"
                   FontFamily="Mohave-Regular" FontSize="20" TextColor="#000000" HorizontalTextAlignment="Center" />
            </FlexLayout>

            
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
