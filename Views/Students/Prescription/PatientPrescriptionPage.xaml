<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:HealthCare.Components"
             x:Class="HealthCare.Views.Students.Prescription.PatientPrescriptionPage"
             BackgroundImageSource="fondete.jpeg"
            BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff}"
            NavigationPage.HasBackButton="False"
            NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="Transparent" Padding="10">
        <!-- Navbar y SideMenu -->
        <StackLayout Grid.Row="0" Spacing="10">
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

            <Label Text="Prescripciones"
               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#000"
               Margin="0,10,0,0" />
        </StackLayout>

        <!-- Lista de prescripciones -->
        <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
            <VerticalStackLayout Padding="10" Spacing="10">
                <CollectionView x:Name="PrescriptionList" Margin="0,5">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#ffffff" 
                               CornerRadius="10" 
                               Padding="15" 
                               HasShadow="True" 
                               Margin="0,10">
                                <VerticalStackLayout Spacing="15">
                                    <Frame BackgroundColor="#ffffff" 
                                           CornerRadius="10" 
                                           Padding="15" 
                                           HasShadow="True" 
                                           Margin="0,10">
                                        <!-- Contenido de la card -->
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                            <!-- Doctor -->
                                            <Label Text="👨‍⚕️ Doctor:"
                                                   FontAttributes="Bold"
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   TextColor="#000000" 
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding DoctorName}" 
                                                   TextColor="#000000" 
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   VerticalOptions="Center" 
                                                   Grid.Column="1" />
                                            <!-- Dosis -->
                                            <Label Text="💊 Dosis:"
                                                   FontAttributes="Bold"
                                                   TextColor="#000000" 
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   VerticalOptions="Center" 
                                                   Grid.Row="1" />
                                            <Label Text="{Binding Dosage}" 
                                                   TextColor="#000000" 
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   VerticalOptions="Center" 
                                                   Grid.Row="1" Grid.Column="1" />
                                            <!-- Descripción -->
                                            <Label Text="📋 Descripción:"
                                                   FontAttributes="Bold"
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   TextColor="#000000" 
                                                   VerticalOptions="Center" 
                                                   Grid.Row="2" />
                                            <Label Text="{Binding Description}" 
                                                   TextColor="#000000" 
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   VerticalOptions="Center" 
                                                   Grid.Row="2" Grid.Column="1" />
                                            <!-- Fecha -->
                                            <Label Text="📅 Fecha:"
                                                   FontAttributes="Bold"
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   TextColor="#000000" 
                                                   VerticalOptions="Center" 
                                                   Grid.Row="3" />
                                            <Label Text="{Binding IssueDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" 
                                                   TextColor="#000000" 
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   VerticalOptions="Center" 
                                                   Grid.Row="3" Grid.Column="1" />
                                            <!-- Medicamento -->
                                            <Label Text="💊 Medicamento:"
                                                   FontAttributes="Bold"
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   TextColor="#000000" 
                                                   VerticalOptions="Center" 
                                                   Grid.Row="4" />
                                            <Label Text="{Binding MedicationName}" 
                                                   TextColor="#000000" 
                                                   FontFamily="MohaveRegular"
                                                   FontSize="20"
                                                   VerticalOptions="Center" 
                                                   Grid.Row="4" Grid.Column="1" 
                                                   LineBreakMode="WordWrap" 
                                                   HorizontalOptions="FillAndExpand"/>
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
