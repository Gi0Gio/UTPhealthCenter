<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:HealthCare.Components"
             x:Class="HealthCare.Views.Students.Prescription.PatientPrescriptionPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#ffffff">
        <!-- Navbar and SideMenu -->
        <StackLayout Grid.Row="0">
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />
            <Label Text="Prescripciones"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#000000"
                   Margin="0,10,0,0" />
        </StackLayout>

        <!-- Patient's Prescriptions List -->
        <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
            <VerticalStackLayout Padding="10" Spacing="5">
                <CollectionView x:Name="PrescriptionList" Margin="10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#d9d9d9" CornerRadius="8" Padding="10" HasShadow="True" Margin="2">
                                <VerticalStackLayout>
                                    <Label Text="Doctor" FontFamily="Mohave-Regular" FontAttributes="Bold" TextColor="#000000"/>
                                    <Label Text="{Binding DoctorName}" FontFamily="Mohave-Regular" TextColor="#000000" />

                                    <Label Text="Dosis" FontFamily="Mohave-Regular" FontAttributes="Bold" TextColor="#000000" />
                                    <Label Text="{Binding Dosage}" FontFamily="MohaveRegular" TextColor="#000000" />

                                    <Label Text="Descripción de la cita" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                                    <Label Text="{Binding Description}" FontFamily="MohaveRegular" TextColor="#000000" />

                                    <Label Text="Fecha" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                                    <Label Text="{Binding IssueDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontFamily="MohaveRegular" TextColor="#000000" />

                                    <Label Text="Medicamento" FontFamily="MohaveRegular" FontAttributes="Bold" TextColor="#000000" />
                                    <Label Text="{Binding MedicationName}" FontFamily="MohaveRegular" TextColor="#000000" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
