<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.CertificatesPage"
             Title="CertificatesPage">

    <StackLayout Padding="20" Spacing="20">
        <Label Text="Certificados y Estudios"
               FontSize="Large"
               TextColor="Black"
               HorizontalOptions="Center" />

        <!-- Botón para emitir certificado de buena salud -->
        <Button Text="Emitir Certificado de Buena Salud"
                Command="{Binding GenerateHealthCertificateCommand}"
                BackgroundColor="#007ACC"
                TextColor="White"
                HorizontalOptions="Center"
                WidthRequest="200" />

        <!-- Solicitudes de estudio del gabinete -->
        <CollectionView ItemsSource="{Binding StudyRequests}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Vertical" Padding="10">
                        <Label Text="{Binding Name}" FontSize="Medium" TextColor="Black"/>
                        <Button Text="Generar PDF"
                                Command="{Binding Path=BindingContext.GenerateStudyPdfCommand, Source={x:Reference CertificatesPage}}"
                                CommandParameter="{Binding Id}"
                                BackgroundColor="#007ACC" TextColor="White"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
    
</ContentPage>