<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Doctors.MedicalProcedure"
             Title="Medical Procedure"
             xmlns:components="clr-namespace:HealthCare.Components"
             BackgroundImageSource="fondete.jpeg"
             BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff, Tablet=#fff}"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

            <Label Text="Procedimientos Médicos"
                   FontSize="35"
                   FontAttributes="Bold"
                   TextColor="#000"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="20">
                <!-- Formulario de Procedimiento Médico -->
                <Frame BackgroundColor="#fff" Grid.Column="0" CornerRadius="15" BorderColor="#fff">
                    <ContentView BackgroundColor="#fff" Padding="20">
                        <VerticalStackLayout>
                            <Label Text="Registrar Procedimiento"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#333"
                                   Margin="0, 0, 0, 10"/>

                            <Label Text="Paciente" TextColor="Black" FontSize="18" FontAttributes="Bold" />
                            <Picker x:Name="PatientPicker" BackgroundColor="#f6f6f6" TextColor="Black" />

                            <Label Text="Diagnóstico" TextColor="Black" FontSize="18" FontAttributes="Bold" />
                            <Entry x:Name="DiagnosisEntry" Placeholder="Descripción del diagnóstico"
                                   TextColor="Black" FontSize="18" PlaceholderColor="#000" />

                            <Label Text="Medicamento" TextColor="Black" FontSize="18" FontAttributes="Bold" />
                            <Picker x:Name="MedicationPicker" BackgroundColor="#f6f6f6" TextColor="Black" />

                            <Label Text="Procedimiento" TextColor="Black" FontSize="18" FontAttributes="Bold" />
                            <Entry x:Name="ProcedureEntry" Placeholder="Procedimiento realizado"
                                   TextColor="Black" FontSize="18" PlaceholderColor="#000" />

                            <Label Text="Notas" TextColor="Black" FontSize="18" FontAttributes="Bold" />
                            <Entry x:Name="NotesEntry" Placeholder="Notas adicionales"
                                   TextColor="Black" FontSize="18" PlaceholderColor="#000" Margin="0, 0, 0, 10"/>

                            <Button Text="Guardar Procedimiento" BackgroundColor="#006AAB" TextColor="White" Clicked="OnSaveProcedure" />
                        </VerticalStackLayout>
                    </ContentView>
                </Frame>

                <!-- Lista de Procedimientos -->
                <Frame BackgroundColor="#fff" Grid.Column="1" CornerRadius="15" BorderColor="#fff">
                    <ContentView Padding="20">
                        <VerticalStackLayout>
                            <Label Text="Lista de Procedimientos" FontSize="24" FontAttributes="Bold" TextColor="#333" Margin="0, 0, 0, 10"/>
                            <CollectionView x:Name="ProcedureList" Margin="10">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="1" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame BackgroundColor="#f0efeb" CornerRadius="10" Padding="10" Margin="5">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding PatientName}" FontAttributes="Bold" FontSize="16" TextColor="#000" />
                                                <Label Text="{Binding Diagnosis}" FontSize="14" TextColor="#000" />
                                                <Label Text="{Binding ProcedurePerformed}" FontSize="14" TextColor="#000" />
                                                <Label Text="{Binding Notes}" FontSize="12" TextColor="#000" />
                                                <Label Text="{Binding RecordDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="#000" />
                                                <Label Text="{Binding MedicationName}" FontSize="12" TextColor="#000" />
                                                <Button Text="Eliminar Procedimiento" BackgroundColor="Red" TextColor="White" Clicked="OnDeleteProcedure" CommandParameter="{Binding}" />
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ContentView>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
