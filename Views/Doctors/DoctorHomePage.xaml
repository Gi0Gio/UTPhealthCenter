<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthCare.Views.Doctors.DoctorHomePage"
             xmlns:components="clr-namespace:HealthCare.Components"
             Title="DoctorHomePage"
             BackgroundImageSource="fondete.jpeg"
             BackgroundColor="{OnIdiom Phone=#fff, Desktop=#fff, Tablet=#fff}"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
 
    <ScrollView>
        
        <VerticalStackLayout Padding="20" Spacing="15">

            <components:Navbar IsVisible="{OnIdiom Desktop=true, Phone=false, Tablet=true}" />
            <components:SideMenu IsVisible="{OnIdiom Desktop=false, Phone=true, Tablet=false}" />

        
            <Label Text="Servicios HealthCare "
                FontSize="35"
                FontFamily="MohaveRegular"
                FontAttributes="Italic, Bold"
                TextColor="#000"
                HorizontalOptions="Center"
                Margin="0,0,0,20"/>

            <!-- Diseño para móviles -->
            <OnIdiom x:TypeArguments="View">
                <OnIdiom.Phone>

                    <ScrollView>
                        <VerticalStackLayout Padding="20" Spacing="15">

                            <Frame BackgroundColor="#def7ff" 
                                CornerRadius="15"
                                HasShadow="True"
                                Padding="10"
                                Margin="0,5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Citas" />
                                </Frame.GestureRecognizers>
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="consulta.png"
                                        WidthRequest="50"
                                        HeightRequest="50"/>
                                    <Label Text="Consultas Médicas"
                                        FontSize="30"
                                        FontFamily="Mohave-Regular"
                                        TextColor="Black" 
                                        VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>


                            <Frame BackgroundColor="#def7ff" 
                                CornerRadius="15"
                                HasShadow="True"
                                Padding="10"
                                Margin="0,5">
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="pulso.png"
                                    WidthRequest="50"
                                    HeightRequest="50"/>
                                    <Label Text="Toma de presión"
                                        FontSize="30"
                                        FontFamily="Mohave-Regular"
                                        TextColor="Black" 
                                        VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>


                            <Frame BackgroundColor="#def7ff" 
                                 CornerRadius="15"
                                HasShadow="True"
                                Padding="10"
                                Margin="0,5">
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="pesoytalla.png"
                                    WidthRequest="50"
                                    HeightRequest="50"/>
                                    <Label Text="Control de peso"
                                     FontSize="30"
                                     FontFamily="Mohave-Regular"
                                     TextColor="Black" 
                                     VerticalOptions = "Center"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="#def7ff"
                                CornerRadius="15"
                                HasShadow="True"
                                Padding="10"
                                Margin="0,5">
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="estudianteicono.png"
                                                WidthRequest="50"
                                                HeightRequest="50"/>
                                    <Label Text="Registrar Estudiante"
                                        FontSize="29"
                                        FontFamily="Mohave-Regular"
                                        TextColor="Black" 
                                        VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>


                            <Frame BackgroundColor="#def7ff" 
                                CornerRadius="15"
                                HasShadow="True"
                                Padding="10"
                                Margin="0,5">
                                <HorizontalStackLayout Spacing="15">
                                    <Image Source="estudiante.png"
                                          WidthRequest="50"
                                          HeightRequest="50"/>
                                    <Label Text="Perfil del Estudiante"
                                        FontSize="29"
                                        FontFamily="Mohave-Regular"
                                        TextColor="Black" 
                                        VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </ScrollView>
                </OnIdiom.Phone>

                <OnIdiom.Tablet>
                    <VerticalStackLayout Padding="20" Spacing="20">

                        <!-- Primer grid con 3 frames en la fila superior -->
                        <Grid ColumnSpacing="15" RowSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Primer Servicio -->
                            <Frame Grid.Column="0" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Citas"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="buenaconsulta.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Tus Citas" FontSize="30" FontFamily="Mohave-Regular" 
                               TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Segundo Servicio -->
                            <Frame Grid.Column="1" BackgroundColor="#def7ff" 
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Prescripcion"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="receta2.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Crear Prescripción" FontSize="30" FontFamily="Mohave-Regular" 
                               TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Tercer Servicio -->
                            <Frame Grid.Column="2" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Historial"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="consulta.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Historial" FontSize="30" FontFamily="Mohave-Regular" 
                               TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Segundo grid con 2 frames en la fila inferior -->
                        <Grid ColumnSpacing="85" RowSpacing="15" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cuarto Servicio -->
                            <Frame Grid.Column="0" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Pacientes"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                                    <Image Source="estudianteicono.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Pacientes" FontSize="30" FontFamily="Mohave-Regular" 
                               TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Quinto Servicio -->
                            <Frame Grid.Column="1" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Referencias"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="estudiante.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Referencia" FontSize="30" FontFamily="Mohave-Regular" 
                               TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </OnIdiom.Tablet>
                <OnIdiom.Desktop>
                    <VerticalStackLayout Padding="20" Spacing="20">

                        <!-- Primer grid con 3 frames en la fila superior -->
                        <Grid ColumnSpacing="15" RowSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Primer Servicio -->
                            <Frame Grid.Column="0" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Citas"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="buenaconsulta.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Tus Citas" FontSize="30" FontFamily="Mohave-Regular" 
                                    TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Segundo Servicio -->
                            <Frame Grid.Column="1" BackgroundColor="#def7ff" 
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Prescripcion"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="receta2.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Crear Prescripción" FontSize="30" FontFamily="Mohave-Regular" 
                                    TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Tercer Servicio -->
                            <Frame Grid.Column="2" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Historial"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="consulta.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Historial" FontSize="30" FontFamily="Mohave-Regular" 
                                    TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Segundo grid con 2 frames en la fila inferior -->
                        <Grid ColumnSpacing="85" RowSpacing="15" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cuarto Servicio -->
                            <Frame Grid.Column="0" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Pacientes"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                                    <Image Source="estudianteicono.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Pacientes" FontSize="30" FontFamily="Mohave-Regular" 
                                    TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Quinto Servicio -->
                            <Frame Grid.Column="1" BackgroundColor="#def7ff"
                            CornerRadius="15" HasShadow="True" Padding="0" Margin="20" BorderColor="#00000040">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Referencias"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Image Source="estudiante.png" WidthRequest="70" HeightRequest="70"/>
                                    <Label Text="Referencia" FontSize="30" FontFamily="Mohave-Regular" 
                                    TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </OnIdiom.Desktop>
            </OnIdiom>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>